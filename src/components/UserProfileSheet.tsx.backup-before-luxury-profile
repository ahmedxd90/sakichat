// @ts-nocheck
import { Id } from "../../convex/_generated/dataModel";
import { toast } from "../lib/toast";
import { useQuery, useMutation } from "convex/react";
import { api } from "../../convex/_generated/api";
import { useState, memo, useCallback } from "react";
import FriendButton from "./FriendButton";
import { ARAB_COUNTRIES } from "../data/countries";
import UserAvatar from "./UserAvatar";
import { getVipConfig, VipBadge, SuperAdminBadge } from "./VipBadge";
import { getAristocracyConfig, AristocracyBadgeInline } from "./AristocracyBadge";
import { CustomerServiceBadge } from "./CustomerServiceBadge";
import { TitleBadges } from "./TitleBadges";
import { ContentCreatorBadgeIf } from "./ContentCreatorBadge";
import { AgentChargeBadgeIf } from "./AgentChargeBadge";
import SakiIdDisplay from "./SakiIdDisplay";
import { HostAgencyBadgeInline } from "./HostAgencyBadge";
import SVGAPlayer from "./SVGAPlayer";

interface UserProfileSheetProps {
  selectedUser: any;
  myProfile: any;
  isOwner: boolean;
  isAdmin: boolean;
  roomId: Id<"rooms">;
  userActiveItems: any;
  userCpPartner: any;
  onClose: () => void;
  onSendGift: (user: any) => void;
  onViewProfile?: (userId: Id<"users">) => void;
  onMessage?: (userId: Id<"users">) => void;
  muteMember: any;
  muteChatMember: any;
  kickMember: any;
  banMember: any;
  setAdminRole: any;
  onMention?: (name: string) => void;
}

// ── Report Sheet ──
const ReportSheet = memo(function ReportSheet({ userId, onClose }: { userId: Id<"users">; onClose: () => void }) {
  const [reason, setReason] = useState("");
  const [details, setDetails] = useState("");
  const [loading, setLoading] = useState(false);
  const reportUser = useMutation(api.userReports.reportUser);
  const reasons = ["محتوى مسيء أو مزعج", "انتحال شخصية", "تحرش أو إزعاج", "محتوى غير لائق", "احتيال أو نصب", "سبب آخر"];
  const handleSubmit = async () => {
    if (!reason) { toast.error("اختر سبب الإبلاغ"); return; }
    setLoading(true);
    try { await reportUser({ reportedUserId: userId, reason, details: details || undefined }); toast.success("تم إرسال البلاغ ✅"); onClose(); }
    catch (e: any) { toast.error(e); }
    finally { setLoading(false); }
  };
  return (
    <div className="fixed inset-0 z-[200] flex items-end" onClick={onClose}>
      <div className="absolute inset-0 bg-black/70 backdrop-blur-sm" />
      <div className="relative w-full rounded-t-3xl p-5" style={{ background: "#1a1a2e", border: "1px solid rgba(239,68,68,0.3)" }} onClick={(e) => e.stopPropagation()}>
        <div className="flex justify-center mb-4"><div className="w-10 h-1 bg-white/20 rounded-full" /></div>
        <h3 className="text-white font-black text-base mb-4 text-center">🚨 الإبلاغ عن مستخدم</h3>
        <div className="space-y-2 mb-4">
          {reasons.map((r) => (
            <button key={r} onClick={() => setReason(r)} className="w-full text-right px-4 py-3 rounded-xl text-sm font-bold transition-all active:scale-95"
              style={reason === r ? { background: "rgba(239,68,68,0.2)", border: "1px solid rgba(239,68,68,0.5)", color: "#f87171" } : { background: "rgba(255,255,255,0.05)", border: "1px solid rgba(255,255,255,0.1)", color: "#9ca3af" }}>
              {reason === r ? "✓ " : ""}{r}
            </button>
          ))}
        </div>
        <textarea value={details} onChange={(e) => setDetails(e.target.value)} placeholder="تفاصيل إضافية (اختياري)..." rows={2}
          className="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-red-500/50 resize-none mb-4" />
        <div className="flex gap-3">
          <button onClick={onClose} className="flex-1 py-3 rounded-xl bg-white/5 text-gray-400 text-sm font-bold">إلغاء</button>
          <button onClick={handleSubmit} disabled={loading || !reason} className="flex-1 py-3 rounded-xl text-white text-sm font-black disabled:opacity-50 active:scale-95" style={{ background: "linear-gradient(135deg,#ef4444,#dc2626)" }}>
            {loading ? "جاري الإرسال..." : "إرسال البلاغ"}
          </button>
        </div>
      </div>
    </div>
  );
});

// ── Duration Picker ──
const DurationPicker = memo(function DurationPicker({ type, userName, onConfirm, onClose }: { type: "ban" | "kick"; userName: string; onConfirm: (d: string) => void; onClose: () => void }) {
  const [selected, setSelected] = useState(type === "ban" ? "1d" : "1h");
  const banDurs = [{ id: "1h", label: "ساعة" }, { id: "1d", label: "يوم" }, { id: "7d", label: "7 أيام" }, { id: "1m", label: "شهر" }, { id: "1y", label: "سنة" }, { id: "permanent", label: "دائم ♾️" }];
  const kickDurs = [{ id: "1min", label: "دقيقة" }, { id: "1h", label: "ساعة" }, { id: "1d", label: "يوم" }, { id: "7d", label: "7 أيام" }];
  const durs = type === "ban" ? banDurs : kickDurs;
  const color = type === "ban" ? "#f87171" : "#fb923c";
  const grad = type === "ban" ? "linear-gradient(135deg,#ef4444,#dc2626)" : "linear-gradient(135deg,#f97316,#ea580c)";
  return (
    <div className="fixed inset-0 z-[300] flex items-center justify-center" onClick={onClose}>
      <div className="absolute inset-0 bg-black/80 backdrop-blur-sm" />
      <div className="relative w-[85vw] max-w-sm rounded-3xl p-5" style={{ background: "#1a1a2e", border: `1px solid ${color}40` }} onClick={(e) => e.stopPropagation()}>
        <div className="text-center mb-4">
          <div className="text-3xl mb-2">{type === "ban" ? "🚫" : "👢"}</div>
          <h3 className="text-white font-black text-base">{type === "ban" ? "حظر" : "طرد"} {userName}</h3>
          <p className="text-gray-400 text-xs mt-1">اختر مدة {type === "ban" ? "الحظر" : "الطرد"}</p>
        </div>
        <div className="grid grid-cols-3 gap-2 mb-4">
          {durs.map((d) => (
            <button key={d.id} onClick={() => setSelected(d.id)}
              className="py-2.5 rounded-xl text-sm font-bold transition-all active:scale-95"
              style={selected === d.id ? { background: `${color}20`, border: `1.5px solid ${color}`, color } : { background: "rgba(255,255,255,0.05)", border: "1px solid rgba(255,255,255,0.1)", color: "#9ca3af" }}>
              {d.label}
            </button>
          ))}
        </div>
        <div className="flex gap-3">
          <button onClick={onClose} className="flex-1 py-3 rounded-xl bg-white/5 text-gray-400 text-sm font-bold">إلغاء</button>
          <button onClick={() => onConfirm(selected)} className="flex-1 py-3 rounded-xl text-white text-sm font-black active:scale-95" style={{ background: grad }}>تأكيد</button>
        </div>
      </div>
    </div>
  );
});

function getRoomRoleLabel(role: string) {
  if (role === "owner") return { label: "المالك", color: "#fff", bg: "linear-gradient(135deg,#7c3aed,#4338ca)", shadow: "0 2px 8px rgba(124,58,237,0.4)" };
  if (role === "admin") return { label: "مشرف", color: "#fff", bg: "linear-gradient(135deg,#a78bfa,#7c3aed)", shadow: "0 2px 8px rgba(167,139,250,0.4)" };
  return { label: "عضو", color: "#fff", bg: "linear-gradient(135deg,#3b82f6,#2563eb)", shadow: "0 2px 8px rgba(59,130,246,0.4)" };
}

const ARISTO_COLORS: Record<number, string> = {
  1: "#60a5fa", 2: "#34d399", 3: "#a78bfa",
  4: "#f472b6", 5: "#fb923c", 6: "#f97316",
  7: "#ffd700", 8: "#e879f9",
};

// ── Main Component ──
export default function UserProfileSheet({
  selectedUser, myProfile, isOwner, isAdmin, roomId,
  userActiveItems, userCpPartner, onClose, onSendGift,
  onViewProfile, onMessage, muteMember, muteChatMember,
  kickMember, banMember, setAdminRole, onMention,
}: UserProfileSheetProps) {
  const actualUserId = selectedUser.userId;
  const userProfile = selectedUser.profile;
  const isMe = actualUserId === myProfile?.userId;

  const [showReport, setShowReport] = useState(false);
  const [showBanPicker, setShowBanPicker] = useState(false);
  const [showKickPicker, setShowKickPicker] = useState(false);

  const banMemberWithDuration = useMutation(api.roomAccess.banMemberWithDuration);
  const kickMemberWithDuration = useMutation(api.roomAccess.kickMemberWithDuration);

  const profileCover = useQuery(
    api.profileCovers.getUserProfileCover,
    actualUserId ? { userId: actualUserId as Id<"users"> } : "skip"
  );

  const isFollowingQuery = useQuery(api.social.isFollowing, actualUserId ? { targetUserId: actualUserId as Id<"users"> } : "skip");
  const followUser = useMutation(api.social.followUser);
  const [localFollowing, setLocalFollowing] = useState<boolean | null>(null);
  const [followLoading, setFollowLoading] = useState(false);
  const isFollowing = localFollowing !== null ? localFollowing : (isFollowingQuery ?? false);

  const handleFollow = useCallback(async () => {
    if (!actualUserId || followLoading) return;
    setFollowLoading(true);
    try {
      const r = await followUser({ targetUserId: actualUserId as Id<"users"> });
      setLocalFollowing(r);
      toast.success(r ? "تمت المتابعة ✅" : "تم إلغاء المتابعة");
    } catch (e: any) { toast.error(e); }
    finally { setFollowLoading(false); }
  }, [actualUserId, followLoading, followUser]);

  const handleBanConfirm = useCallback(async (duration: string) => {
    try {
      await banMemberWithDuration({ roomId, targetUserId: actualUserId as Id<"users">, duration });
      setShowBanPicker(false); onClose(); toast.success("تم الحظر ✅");
    } catch (e: any) { toast.error(e); }
  }, [banMemberWithDuration, roomId, actualUserId, onClose]);

  const handleKickConfirm = useCallback(async (duration: string) => {
    try {
      await kickMemberWithDuration({ roomId, targetUserId: actualUserId as Id<"users">, duration });
      setShowKickPicker(false); onClose(); toast.success("تم الطرد ✅");
    } catch (e: any) { toast.error(e); }
  }, [kickMemberWithDuration, roomId, actualUserId, onClose]);

  if (!actualUserId || !userProfile) {
    return (
      <div className="fixed inset-0 z-[60] flex items-center justify-center" onClick={onClose}>
        <div className="absolute inset-0 bg-black/60 backdrop-blur-sm" />
        <div className="relative rounded-3xl p-6 mx-4 text-center" style={{ background: "#fff" }} onClick={(e) => e.stopPropagation()}>
          <p className="text-gray-600 mb-4 font-bold">لا يمكن تحميل بيانات المستخدم</p>
          <button onClick={onClose} className="px-6 py-2 rounded-2xl text-white font-bold text-sm" style={{ background: "linear-gradient(135deg,#7c3aed,#4338ca)" }}>إغلاق</button>
        </div>
      </div>
    );
  }

  const wealthLevel = userProfile?.wealthLevel ?? 0;
  const charismaLevel = userProfile?.charismaLevel ?? 0;
  const country = ARAB_COUNTRIES.find((c) => c.code === userProfile?.country);
  const gender = userProfile?.gender;
  const roleInfo = getRoomRoleLabel(selectedUser.role ?? "visitor");
  const canAdminAction = !isMe && (isOwner || isAdmin) && selectedUser.role !== "owner";
  const isSuperAdminUser = userProfile?.isSuperAdmin ?? false;
  const isVip = userProfile?.isVip ?? false;
  const vipLevel = userProfile?.vipLevel ?? 0;
  const vipConfig = getVipConfig(vipLevel);
  const aristocracyLevel = userProfile?.aristocracyLevel ?? 0;
  const aristocracyExpiresAt = userProfile?.aristocracyExpiresAt ?? null;
  const aristocracyActive = aristocracyLevel > 0 && aristocracyExpiresAt && aristocracyExpiresAt > Date.now();
  const aristocracyConfig = getAristocracyConfig(aristocracyActive ? aristocracyLevel : null);
  const isPrivate = (userProfile?.isPrivateProfile ?? false) && !isMe;
  const followersCount = userProfile?.followersCount ?? 0;

  // Name color
  const nameColor = aristocracyActive
    ? ARISTO_COLORS[aristocracyLevel] ?? "#f97316"
    : isVip && vipConfig
      ? vipConfig.nameColor
      : isSuperAdminUser
        ? "#ffd700"
        : "#f97316";

  // Cover gradient
  const coverBg = aristocracyActive && aristocracyConfig
    ? aristocracyConfig.bgGradient
    : isVip && vipConfig
      ? vipConfig.bgGradient
      : "linear-gradient(135deg,#7c3aed 0%,#4338ca 50%,#1e1b4b 100%)";

  return (
    <>
      <style>{`
        @keyframes slideUpCard {
          from { transform: translateY(100%); opacity: 0; }
          to { transform: translateY(0); opacity: 1; }
        }
        @keyframes avatarPop {
          0% { transform: scale(0.7); opacity: 0; }
          70% { transform: scale(1.08); }
          100% { transform: scale(1); opacity: 1; }
        }
        .profile-card-new {
          animation: slideUpCard 0.38s cubic-bezier(0.32,0.72,0,1);
        }
        .avatar-pop {
          animation: avatarPop 0.45s cubic-bezier(0.34,1.56,0.64,1) 0.1s both;
        }
      `}</style>

      {/* Backdrop */}
      <div className="fixed inset-0 z-[60] flex flex-col justify-end" onClick={onClose}>
        <div className="absolute inset-0" style={{ background: "rgba(15,23,42,0.75)", backdropFilter: "blur(6px)" }} />

        {/* ── WHITE CARD ── */}
        <div
          className="profile-card-new relative w-full"
          style={{
            borderRadius: "32px 32px 0 0",
            background: "#ffffff",
            boxShadow: "0 -12px 60px rgba(0,0,0,0.35)",
            maxHeight: "92vh",
            overflow: "hidden",
          }}
          onClick={(e) => e.stopPropagation()}
        >
          {/* Drag handle */}
          <div className="flex justify-center pt-3 pb-0" style={{ position: "relative", zIndex: 10 }}>
            <div className="w-10 h-1.5 rounded-full" style={{ background: "#e2e8f0" }} />
          </div>

          {/* ── COVER BANNER ── */}
          <div style={{ position: "relative", height: 140, overflow: "visible", marginBottom: -52 }}>
            {/* خلفية gradient شفافة */}
            <div style={{ width: "100%", height: "100%", background: coverBg, opacity: 0.85 }} />
            {/* غلاف SVGA يملأ المنطقة بالكامل */}
            {profileCover?.svgaUrl && (
              <div style={{ position: "absolute", inset: 0, zIndex: 2, pointerEvents: "none" }}>
                <SVGAPlayer src={profileCover.svgaUrl} loop={true} width={420} height={140}
                  style={{ width: "100%", height: "100%" }} />
              </div>
            )}
            {/* تدرج شفاف للأسفل */}
            <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, height: 60, background: "linear-gradient(to bottom, transparent, rgba(255,255,255,0.95))", zIndex: 3 }} />

            {/* Report btn */}
            {!isMe && (
              <button
                onClick={() => setShowReport(true)}
                className="absolute top-3 left-3 w-8 h-8 rounded-full flex items-center justify-center active:scale-90 transition-transform"
                style={{ background: "rgba(255,255,255,0.25)", border: "1.5px solid rgba(255,255,255,0.5)", backdropFilter: "blur(8px)", zIndex: 10 }}
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5">
                  <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                  <line x1="4" y1="22" x2="4" y2="15" />
                </svg>
              </button>
            )}

            {/* Mention btn */}
            {!isMe && !isPrivate && (
              <button
                onClick={() => { onMention?.(`@${userProfile?.name} `); onClose(); }}
                className="absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center font-black text-white active:scale-90 transition-transform"
                style={{ background: "rgba(255,255,255,0.25)", border: "1.5px solid rgba(255,255,255,0.5)", backdropFilter: "blur(8px)", fontSize: 15, zIndex: 10 }}
              >@</button>
            )}
          </div>

          {/* ── AVATAR ── نفس طريقة UserProfilePage بالضبط */}
          <div style={{ display: "flex", justifyContent: "center", zIndex: 10, position: "relative" }}>
            <div className="avatar-pop">
              {isPrivate
                ? (
                  <div style={{
                    width: 96, height: 96, borderRadius: "50%",
                    background: "#f1f5f9",
                    display: "flex", alignItems: "center", justifyContent: "center",
                    fontSize: 32,
                    border: "3px solid #fff",
                    boxShadow: "0 4px 16px rgba(0,0,0,0.15)",
                  }}>🔒</div>
                )
                : (
                  <div style={{ position: "relative", display: "inline-flex", overflow: "visible" }}>
                    <UserAvatar
                      userId={actualUserId}
                      avatarUrl={userProfile?.avatarUrl}
                      name={userProfile?.name}
                      size={96}
                      showFrame={true}
                      isSuperAdmin={isSuperAdminUser}
                      isVip={isVip}
                      vipLevel={vipLevel}
                    />
                  </div>
                )
              }
            </div>
          </div>

          {/* ── SCROLLABLE CONTENT ── */}
          <div className="overflow-y-auto overscroll-contain" style={{ maxHeight: "calc(92vh - 220px)" }}>
            <div className="px-5 pt-4 pb-4 text-center" dir="rtl">

              {/* Role badge + Name */}
              <div className="flex items-center justify-center gap-2 mb-1 flex-wrap">
                <span className="text-xs font-black px-3 py-0.5 rounded-full text-white"
                  style={{ background: roleInfo.bg, boxShadow: roleInfo.shadow }}>
                  {roleInfo.label}
                </span>
                <h2 className="font-black text-xl tracking-wide" style={{ color: nameColor }}>
                  {userProfile?.name ?? "مجهول"}
                </h2>
                {gender && (
                  <span style={{ color: gender === "male" ? "#3b82f6" : "#ec4899", fontWeight: 700, fontSize: 16 }}>
                    {gender === "male" ? "♂" : "♀"}
                  </span>
                )}
                {country && <span style={{ fontSize: "1.1rem" }}>{country.flag}</span>}
              </div>

              {/* Badges row */}
              {!isPrivate && (
                <div className="flex items-center justify-center gap-1.5 flex-wrap mb-3">
                  {isSuperAdminUser && <SuperAdminBadge size="sm" adminTitle={userProfile?.adminTitle} adminTitleColor1={userProfile?.adminTitleColor1} adminTitleColor2={userProfile?.adminTitleColor2} adminTitleIconUrl={userProfile?.adminTitleIconUrl} adminTitleBg={userProfile?.adminTitleBg} />}
                  {aristocracyActive && aristocracyConfig && <AristocracyBadgeInline level={aristocracyLevel} size="sm" />}
                  {isVip && vipLevel > 0 && <VipBadge level={vipLevel} size="sm" />}
                  {userProfile?.isCustomerService && <CustomerServiceBadge size="sm" />}
                  <AgentChargeBadgeIf profile={userProfile} size="sm" />
                  <ContentCreatorBadgeIf profile={userProfile} size="sm" />
                  <TitleBadges profile={userProfile} size="sm" />
                  <HostAgencyBadgeInline userId={actualUserId as Id<"users">} size="sm" />
                </div>
              )}

              {/* PRIVATE PROFILE */}
              {isPrivate ? (
                <>
                  <div className="mb-4 p-4 rounded-2xl" style={{ background: "#f8fafc", border: "1.5px solid #e2e8f0" }}>
                    <div className="text-3xl mb-2">🔒</div>
                    <p className="font-black text-sm" style={{ color: "#334155" }}>ملف شخصي خاص</p>
                    <p className="text-xs mt-1" style={{ color: "#94a3b8" }}>لا يمكن عرض هذا الملف الشخصي</p>
                  </div>
                  {!isMe && (
                    <div className="grid grid-cols-2 gap-3 mb-3">
                      <button onClick={handleFollow} disabled={followLoading}
                        className="py-3 rounded-2xl flex flex-col items-center justify-center gap-1 font-bold text-xs active:scale-95 transition-transform disabled:opacity-60"
                        style={isFollowing
                          ? { background: "#f1f5f9", border: "1.5px solid #e2e8f0", color: "#64748b" }
                          : { background: "linear-gradient(135deg,#f97316,#ea580c)", color: "#fff", border: "none", boxShadow: "0 4px 12px rgba(249,115,22,0.35)" }}>
                        {followLoading
                          ? <div className="w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin" />
                          : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                              <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" />
                              <line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />
                            </svg>}
                        {isFollowing ? "متابَع" : "متابعة"}
                      </button>
                      <button onClick={() => { onClose(); onMessage?.(actualUserId as Id<"users">); }}
                        className="py-3 rounded-2xl flex flex-col items-center justify-center gap-1 font-bold text-xs active:scale-95 transition-transform"
                        style={{ background: "linear-gradient(135deg,#7c3aed,#4338ca)", color: "#fff", border: "none", boxShadow: "0 4px 12px rgba(124,58,237,0.35)" }}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                        </svg>
                        رسالة
                      </button>
                    </div>
                  )}
                </>
              ) : (
                <>
                  {/* ID + Followers row */}
                  <div className="flex items-center justify-center gap-3 mb-4 flex-wrap">
                    <div className="flex items-center gap-1.5 px-3 py-1.5 rounded-xl"
                      style={{ background: "#1e293b", border: "1px solid #334155" }}>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" strokeWidth="2">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                      </svg>
                      <SakiIdDisplay sakiId={userProfile?.sakiId ?? ""} profile={userProfile} fontSize={11} iconSize={13} />
                    </div>
                    {followersCount > 0 && (
                      <div className="flex items-center gap-1 px-3 py-1.5 rounded-xl"
                        style={{ background: "#fdf2f8", border: "1px solid #fbcfe8" }}>
                        <span style={{ color: "#ec4899", fontSize: 11, fontWeight: 700 }}>المشجعين :</span>
                        <span style={{ color: "#be185d", fontSize: 11, fontWeight: 900 }}>{followersCount.toLocaleString()}</span>
                      </div>
                    )}
                  </div>

                  {/* Wealth & Charisma pills */}
                  {(wealthLevel > 0 || charismaLevel > 0) && (
                    <div className="flex items-center justify-center gap-2 mb-4 flex-wrap">
                      {wealthLevel > 0 && (
                        <div className="flex items-center gap-1.5 px-4 py-1.5 rounded-full font-black text-xs text-white"
                          style={{ background: "linear-gradient(135deg,#f59e0b,#d97706)", boxShadow: "0 3px 10px rgba(245,158,11,0.4)" }}>
                          <span style={{ opacity: 0.85 }}>ثروة</span>
                          <span>{wealthLevel}</span>
                          <span>👑</span>
                        </div>
                      )}
                      {charismaLevel > 0 && (
                        <div className="flex items-center gap-1.5 px-4 py-1.5 rounded-full font-black text-xs text-white"
                          style={{ background: "linear-gradient(135deg,#ec4899,#db2777)", boxShadow: "0 3px 10px rgba(236,72,153,0.4)" }}>
                          <span style={{ opacity: 0.85 }}>كاريزما</span>
                          <span>{charismaLevel}</span>
                          <span>🔥</span>
                        </div>
                      )}
                    </div>
                  )}

                  {/* CP Partner */}
                  {userCpPartner && (
                    <div className="mb-4 p-3 rounded-2xl" style={{ background: "#fdf2f8", border: "1.5px solid #fbcfe8" }}>
                      <p className="text-xs font-black mb-2" style={{ color: "#be185d" }}>✨ العلاقة المميزة ✨</p>
                      <div className="flex items-center justify-center gap-5">
                        <div className="rounded-full overflow-hidden" style={{ width: 48, height: 48, border: "2.5px solid #f9a8d4" }}>
                          {userProfile?.avatarUrl
                            ? <img src={userProfile.avatarUrl} alt="" className="w-full h-full object-cover" />
                            : <div className="w-full h-full flex items-center justify-center" style={{ background: "#fce7f3" }}><span style={{ color: "#be185d", fontWeight: 700 }}>{userProfile?.name?.[0]}</span></div>
                          }
                        </div>
                        <span style={{ fontSize: "1.5rem" }}>💗</span>
                        <div className="rounded-full overflow-hidden" style={{ width: 48, height: 48, border: "2.5px solid #f9a8d4" }}>
                          {userCpPartner.partnerAvatarUrl
                            ? <img src={userCpPartner.partnerAvatarUrl} alt="" className="w-full h-full object-cover" />
                            : <div className="w-full h-full flex items-center justify-center" style={{ background: "#ede9fe" }}><span style={{ color: "#7c3aed", fontWeight: 700 }}>{userCpPartner.partnerName?.[0]}</span></div>
                          }
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Bio */}
                  {userProfile?.bio && (
                    <p className="text-xs mb-4 font-medium" style={{ color: "#94a3b8" }}>{userProfile.bio}</p>
                  )}

                  {/* ── ACTION BUTTONS ── */}
                  {!isMe && (
                    <div className="flex items-center justify-around pt-4 mb-3" style={{ borderTop: "1.5px solid #f1f5f9" }}>
                      {/* Gift */}
                      <button onClick={() => { onClose(); onSendGift(selectedUser); }}
                        className="flex flex-col items-center gap-1.5 active:scale-90 transition-transform">
                        <div className="w-12 h-12 rounded-full flex items-center justify-center"
                          style={{ background: "#fef2f2", border: "1.5px solid #fecaca" }}>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" strokeWidth="2">
                            <polyline points="20 12 20 22 4 22 4 12" /><rect x="2" y="7" width="20" height="5" />
                            <line x1="12" y1="22" x2="12" y2="7" />
                            <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z" />
                            <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" />
                          </svg>
                        </div>
                        <span className="text-[10px] font-bold" style={{ color: "#ef4444" }}>هدية</span>
                      </button>

                      {/* View Profile */}
                      {onViewProfile && (
                        <button onClick={() => { onClose(); onViewProfile(actualUserId as Id<"users">); }}
                          className="flex flex-col items-center gap-1.5 active:scale-90 transition-transform">
                          <div className="w-12 h-12 rounded-full flex items-center justify-center"
                            style={{ background: "#eff6ff", border: "1.5px solid #bfdbfe" }}>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" strokeWidth="2">
                              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" />
                            </svg>
                          </div>
                          <span className="text-[10px] font-bold" style={{ color: "#3b82f6" }}>الملف</span>
                        </button>
                      )}

                      {/* Mention */}
                      <button onClick={() => { onMention?.(`@${userProfile?.name} `); onClose(); }}
                        className="flex flex-col items-center gap-1.5 active:scale-90 transition-transform">
                        <div className="w-12 h-12 rounded-full flex items-center justify-center font-black text-lg"
                          style={{ background: "#f5f3ff", border: "1.5px solid #ddd6fe", color: "#7c3aed" }}>
                          @
                        </div>
                        <span className="text-[10px] font-bold" style={{ color: "#7c3aed" }}>ذكر</span>
                      </button>

                      {/* Follow */}
                      <button onClick={handleFollow} disabled={followLoading}
                        className="flex flex-col items-center gap-1.5 active:scale-90 transition-transform disabled:opacity-60">
                        <div className="w-12 h-12 rounded-full flex items-center justify-center"
                          style={isFollowing
                            ? { background: "#f1f5f9", border: "1.5px solid #e2e8f0" }
                            : { background: "#fff7ed", border: "1.5px solid #fed7aa" }}>
                          {followLoading
                            ? <div className="w-5 h-5 border-2 border-orange-400 border-t-transparent rounded-full animate-spin" />
                            : <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={isFollowing ? "#94a3b8" : "#f97316"} strokeWidth="2.5">
                                {isFollowing
                                  ? <><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /><path d="M16 11l2 2 4-4" /></>
                                  : <><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></>
                                }
                              </svg>
                          }
                        </div>
                        <span className="text-[10px] font-bold" style={{ color: isFollowing ? "#94a3b8" : "#f97316" }}>
                          {isFollowing ? "متابَع" : "متابعة"}
                        </span>
                      </button>
                    </div>
                  )}

                  {/* Friend + Message row */}
                  {!isMe && (
                    <div className="grid grid-cols-2 gap-3 mb-3">
                      <div className="rounded-2xl overflow-hidden" style={{ background: "#eff6ff", border: "1.5px solid #bfdbfe" }}>
                        <FriendButton targetUserId={actualUserId as Id<"users">} compactGrid />
                      </div>
                      <button onClick={() => { onClose(); onMessage?.(actualUserId as Id<"users">); }}
                        className="py-3 rounded-2xl flex items-center justify-center gap-2 font-bold text-sm active:scale-95 transition-transform text-white"
                        style={{ background: "linear-gradient(135deg,#7c3aed,#4338ca)", boxShadow: "0 4px 14px rgba(124,58,237,0.35)" }}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                        </svg>
                        رسالة
                      </button>
                    </div>
                  )}
                </>
              )}

              <div style={{ height: canAdminAction ? 76 : 12 }} />
            </div>
          </div>

          {/* ── ADMIN TOOLBAR ── */}
          {canAdminAction && (
            <div
              className="absolute bottom-0 left-0 right-0 flex items-center justify-around px-3 py-2"
              style={{
                background: "#1e293b",
                borderTop: "1px solid #334155",
                paddingBottom: "max(10px, env(safe-area-inset-bottom))",
              }}
            >
              {/* Set Admin */}
              {isOwner && (
                <button
                  onClick={async () => {
                    try {
                      await setAdminRole({ roomId, targetUserId: actualUserId as Id<"users">, isAdmin: selectedUser.role !== "admin" });
                      onClose();
                      toast.success(selectedUser.role !== "admin" ? "تم تعيين مشرف ✅" : "تم إزالة المشرف");
                    } catch (e: any) { toast.error(e); }
                  }}
                  className="flex flex-col items-center gap-1 active:scale-90 transition-transform"
                >
                  <div className="w-10 h-10 rounded-2xl flex items-center justify-center" style={{ background: "rgba(167,139,250,0.15)", border: "1px solid rgba(167,139,250,0.3)" }}>
                    <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
                      <path d="M16 3L4 8v8c0 7 5.5 12 12 13 6.5-1 12-6 12-13V8L16 3z" stroke="#a78bfa" strokeWidth="2" fill="rgba(167,139,250,0.15)" />
                      <path d="M11 16l3 3 7-7" stroke="#a78bfa" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
                    </svg>
                  </div>
                  <span className="text-[9px] font-bold" style={{ color: "#a78bfa" }}>{selectedUser.role === "admin" ? "إزالة" : "مشرف"}</span>
                </button>
              )}

              {/* Mute Chat */}
              <button
                onClick={async () => {
                  try { await muteChatMember({ roomId, targetUserId: actualUserId as Id<"users">, isMuted: !selectedUser.isChatMuted }); onClose(); }
                  catch (e: any) { toast.error(e); }
                }}
                className="flex flex-col items-center gap-1 active:scale-90 transition-transform"
              >
                <div className="w-10 h-10 rounded-2xl flex items-center justify-center" style={{ background: "rgba(99,102,241,0.15)", border: "1px solid rgba(99,102,241,0.3)" }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" strokeWidth="2">
                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                    {selectedUser.isChatMuted && <line x1="4" y1="4" x2="20" y2="20" stroke="#ef4444" strokeWidth="2" />}
                  </svg>
                </div>
                <span className="text-[9px] font-bold" style={{ color: "#818cf8" }}>{selectedUser.isChatMuted ? "رفع الكتم" : "كتم دردشة"}</span>
              </button>

              {/* Mute Mic */}
              <button
                onClick={async () => {
                  try { await muteMember({ roomId, targetUserId: actualUserId as Id<"users">, isMuted: !selectedUser.isMuted }); onClose(); }
                  catch (e: any) { toast.error(e); }
                }}
                className="flex flex-col items-center gap-1 active:scale-90 transition-transform"
              >
                <div className="w-10 h-10 rounded-2xl flex items-center justify-center" style={{ background: "rgba(234,179,8,0.15)", border: "1px solid rgba(234,179,8,0.3)" }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" strokeWidth="2">
                    {selectedUser.isMuted
                      ? <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3zM19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" />
                      : <path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    }
                  </svg>
                </div>
                <span className="text-[9px] font-bold" style={{ color: "#fbbf24" }}>{selectedUser.isMuted ? "رفع الكتم" : "كتم صوت"}</span>
              </button>

              {/* Kick */}
              <button onClick={() => setShowKickPicker(true)} className="flex flex-col items-center gap-1 active:scale-90 transition-transform">
                <div className="w-10 h-10 rounded-2xl flex items-center justify-center" style={{ background: "rgba(249,115,22,0.15)", border: "1px solid rgba(249,115,22,0.3)" }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fb923c" strokeWidth="2">
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" />
                  </svg>
                </div>
                <span className="text-[9px] font-bold" style={{ color: "#fb923c" }}>طرد</span>
              </button>

              {/* Ban */}
              {isOwner && (
                <button onClick={() => setShowBanPicker(true)} className="flex flex-col items-center gap-1 active:scale-90 transition-transform">
                  <div className="w-10 h-10 rounded-2xl flex items-center justify-center" style={{ background: "rgba(239,68,68,0.15)", border: "1px solid rgba(239,68,68,0.3)" }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f87171" strokeWidth="2">
                      <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                    </svg>
                  </div>
                  <span className="text-[9px] font-bold" style={{ color: "#f87171" }}>حظر</span>
                </button>
              )}
            </div>
          )}
        </div>
      </div>

      {showReport && <ReportSheet userId={actualUserId as Id<"users">} onClose={() => setShowReport(false)} />}
      {showBanPicker && <DurationPicker type="ban" userName={userProfile?.name ?? ""} onConfirm={handleBanConfirm} onClose={() => setShowBanPicker(false)} />}
      {showKickPicker && <DurationPicker type="kick" userName={userProfile?.name ?? ""} onConfirm={handleKickConfirm} onClose={() => setShowKickPicker(false)} />}
    </>
  );
}
