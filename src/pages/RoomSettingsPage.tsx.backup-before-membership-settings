interface RoomSettingsPageProps {
  roomId: Id<"rooms">;
  onBack: () => void;
}

const SEAT_OPTIONS = [5, 10, 15, 20];

const ROOM_THEMES = [
  { value: "", label: "الافتراضي", icon: "🏠", gradient: "linear-gradient(135deg,#1a1a2e,#16213e)" },
  { value: "cp", label: "ثيم CP 💑", icon: "💑", gradient: "linear-gradient(135deg,#ff9a9e,#fad0c4,#ffecd2)" },
  { value: "cinema", label: "ثيم السينما 🎬", icon: "🎬", gradient: "linear-gradient(135deg,#1a0000,#3d0000,#ff0000)" },
];

const PRESET_BACKGROUNDS = [
  { key: "stars_planets", label: "نجوم وكواكب", emoji: "🪐", preview: "radial-gradient(ellipse at 20% 50%,#1a0050 0%,#000020 40%,#000510 100%)" },
  { key: "city_night", label: "مدينة جميلة", emoji: "🌆", preview: "linear-gradient(180deg,#0a0a2e 0%,#1a1a4e 30%,#2a1a3e 60%,#1a0a2e 100%)" },
  { key: "desert_night", label: "صحراء بالليل", emoji: "🌙", preview: "linear-gradient(180deg,#050510 0%,#0a0820 30%,#1a1008 60%,#2d1a05 100%)" },
];

const FREE_IMAGE_BACKGROUNDS = [
  { key: "free_bg_1", label: "خلفية 1", url: "https://j.top4top.io/p_3763mqos11.jpg" },
  { key: "free_bg_2", label: "خلفية 2", url: "https://j.top4top.io/p_3763xv9o51.jpg" },
  { key: "free_bg_3", label: "خلفية 3", url: "https://h.top4top.io/p_3763fjsgd1.jpg" },
];

type SubPage = null | "theme" | "background" | "bans" | "youtube" | "lock";

function RoomLockSubPage({ roomId, room, setRoomLock, onBack }: {
  roomId: Id<"rooms">; room: any; setRoomLock: any; onBack: () => void;
}) {
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const isLocked = room?.isLocked ?? false;

  const handleLock = async () => {
    if (!/^\d{4}$/.test(password)) { toast.error("كلمة المرور يجب أن تكون 4 أرقام فقط"); return; }
    setLoading(true);
    try {
      await setRoomLock({ roomId, password });
      toast.success("تم قفل الغرفة 🔒");
      onBack();
    } catch (e: any) { toast.error(e.message ?? e); }
    finally { setLoading(false); }
  };

  const handleUnlock = async () => {
    setLoading(true);
    try {
      await setRoomLock({ roomId, password: undefined });
      toast.success("تم فتح الغرفة 🔓");
      onBack();
    } catch (e: any) { toast.error(e.message ?? e); }
    finally { setLoading(false); }
  };

  return (
    <div className="flex flex-col min-h-screen bg-white" dir="rtl">
      <div className="flex items-center gap-4 px-4 py-4 border-b border-gray-100">
        <button onClick={onBack} className="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#333" strokeWidth="2.5"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <h2 className="flex-1 text-center text-[17px] font-bold text-gray-800">🔒 قفل الغرفة</h2>
        <div className="w-9" />
      </div>
      <div className="flex-1 p-5">
        <div className="flex items-center gap-3 mb-6">
          <div className="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl"
            style={{ background: "rgba(0,191,165,0.12)", border: "1px solid rgba(0,191,165,0.3)" }}>
            {isLocked ? "🔒" : "🔓"}
          </div>
          <div>
            <h3 className="text-gray-800 font-bold text-base">{isLocked ? "الغرفة مقفلة" : "قفل الغرفة"}</h3>
            <p className="text-gray-400 text-xs mt-0.5">{isLocked ? "يمكنك فتح الغرفة أو تغيير كلمة المرور" : "ضع كلمة مرور من 4 أرقام"}</p>
          </div>
        </div>
        <label className="text-gray-500 text-xs font-bold mb-3 block">
          {isLocked ? "كلمة المرور الجديدة" : "كلمة المرور (4 أرقام)"}
        </label>
        <div className="flex gap-3 justify-center mb-4">
          {[0,1,2,3].map((i) => (
            <div key={i} className="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-black text-gray-800"
              style={{ background: password[i] ? "rgba(0,191,165,0.15)" : "#f3f4f6", border: `2px solid ${password[i] ? "#00bfa5" : "#e5e7eb"}` }}>
              {password[i] ? "●" : ""}
            </div>
          ))}
        </div>
        <div className="grid grid-cols-3 gap-2 mb-5">
          {[1,2,3,4,5,6,7,8,9,"",0,"⌫"].map((k, idx) => (
            <button key={idx}
              onClick={() => {
                if (k === "⌫") setPassword(p => p.slice(0,-1));
                else if (k !== "" && password.length < 4) setPassword(p => p + String(k));
              }}
              disabled={k === ""}
              className={`h-12 rounded-2xl text-lg font-bold transition-all active:scale-95 border ${
                k === "" ? "opacity-0 pointer-events-none" :
                k === "⌫" ? "text-red-500 border-red-100 bg-red-50" :
                "text-gray-800 border-gray-200 bg-white"
              }`}>
              {k}
            </button>
          ))}
        </div>
        <div className="space-y-2">
          <button onClick={handleLock} disabled={loading || password.length !== 4}
            className="w-full py-3.5 rounded-2xl text-white font-bold text-base disabled:opacity-50"
            style={{ background: "linear-gradient(135deg,#00bfa5,#00897b)" }}>
            {loading ? "جارٍ..." : "🔒 قفل الغرفة"}
          </button>
          {isLocked && (
            <button onClick={handleUnlock} disabled={loading}
              className="w-full py-3 rounded-2xl font-bold text-sm disabled:opacity-50"
              style={{ background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)", color: "#ef4444" }}>
              🔓 فتح الغرفة
            </button>
          )}
        </div>
      </div>
    </div>
  );
}

function RoyalSeatsToggle({ value, onChange }: { value: boolean; onChange: (v: boolean) => void }) {
  return (
    <div className="flex items-center px-4 py-4">
      <div className="flex-1">
        <p className="text-sm text-gray-700 font-medium">إخفاء مقعد الشيخ والملك</p>
        <p className="text-xs text-gray-400 mt-0.5">إخفاء المقاعد الملكية من الغرفة</p>
      </div>
      <button
        onClick={() => onChange(!value)}
        className="relative w-12 h-6 rounded-full transition-all flex-shrink-0"
        style={{ background: value ? "#00bfa5" : "#e5e7eb" }}
      >
        <div
          className="absolute top-0.5 w-5 h-5 rounded-full bg-white shadow transition-all"
          style={{ left: value ? "calc(100% - 22px)" : "2px" }}
        />
      </button>
    </div>
  );
}

export default function RoomSettingsPage({ roomId, onBack }: RoomSettingsPageProps) {
  const room = useQuery(api.rooms.getRoom, { roomId });
  const bans = useQuery(api.rooms.getRoomBans, { roomId });
  const myProfile = useQuery(api.profiles.getMyProfile);

  const updateRoom = useMutation(api.rooms.updateRoom);
  const purchaseCustomBg = useMutation(api.roomBgPurchase.purchaseCustomBg);
  const unbanMember = useMutation(api.rooms.unbanMember);
  const generateUploadUrl = useMutation(api.rooms.generateUploadUrl);
  const setRoomLock = useMutation(api.rooms.setRoomLock);

  const [name, setName] = useState<string | null>(null);
  const [description, setDescription] = useState<string | null>(null);
  const [coverPreview, setCoverPreview] = useState<string | null>(null);
  const [coverFile, setCoverFile] = useState<File | null>(null);
  const [maxSeats, setMaxSeats] = useState<number | null>(null);
  const [saving, setSaving] = useState(false);
  const [subPage, setSubPage] = useState<SubPage>(null);
  const [pendingTheme, setPendingTheme] = useState<string | null>(null);
  const [bgFile, setBgFile] = useState<File | null>(null);
  const [bgPreview, setBgPreview] = useState<string | null>(null);
  const [purchasingBg, setPurchasingBg] = useState(false);
  const [hideRoyalSeats, setHideRoyalSeats] = useState<boolean | null>(null);

  const fileInputRef = useRef<HTMLInputElement>(null);
  const bgFileInputRef = useRef<HTMLInputElement>(null);

  const currentName = name ?? room?.name ?? "";
  const currentDescription = description ?? room?.description ?? "";
  const currentCover = coverPreview ?? room?.coverUrl ?? null;
  const currentMaxSeats = maxSeats ?? room?.maxSeats ?? 10;
  const currentTheme = pendingTheme ?? (room as any)?.roomTheme ?? "";
  const currentHideRoyalSeats = hideRoyalSeats ?? (room as any)?.hideRoyalSeats ?? false;
  const currentPreset = (room as any)?.bgPresetKey ?? "";
  const currentBgImage = (room as any)?.bgImageUrl ?? null;
  const bgCustomExpiresAt = (room as any)?.bgCustomExpiresAt ?? null;

  const handleCoverSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setCoverFile(file);
    const reader = new FileReader();
    reader.onload = (ev) => setCoverPreview(ev.target?.result as string);
    reader.readAsDataURL(file);
  };

  const handleBgFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (!file.type.startsWith("image/")) { toast.error("يرجى اختيار صورة"); return; }
    if (file.size > 10 * 1024 * 1024) { toast.error("حجم الصورة يجب أن يكون أقل من 10 ميجابايت"); return; }
    setBgFile(file);
    const reader = new FileReader();
    reader.onload = (ev) => setBgPreview(ev.target?.result as string);
    reader.readAsDataURL(file);
  };

  const handleSaveMain = async () => {
    if (!currentName.trim()) { toast.error("اسم الغرفة مطلوب"); return; }
    setSaving(true);
    try {
      let coverStorageId: Id<"_storage"> | undefined;
      if (coverFile) {
        const uploadUrl = await generateUploadUrl();
        const result = await fetch(uploadUrl, { method: "POST", headers: { "Content-Type": coverFile.type }, body: coverFile });
        const json = await result.json();
        if (!result.ok) throw new Error("فشل رفع صورة الغلاف");
        coverStorageId = json.storageId;
      }
      const updateArgs: any = { roomId, name: currentName.trim(), description: currentDescription.trim() || undefined, maxSeats: currentMaxSeats, hideRoyalSeats: currentHideRoyalSeats };
      if (coverStorageId) updateArgs.coverStorageId = coverStorageId;
      await updateRoom(updateArgs);
      toast.success("تم حفظ الإعدادات ✅");
      onBack();
    } catch (e: any) {
      toast.error(e);
    } finally {
      setSaving(false);
    }
  };

  const handleSaveTheme = async () => {
    if (pendingTheme === null) { setSubPage(null); return; }
    setSaving(true);
    try {
      await updateRoom({ roomId, roomTheme: pendingTheme });
      toast.success("تم تغيير الثيم ✅");
      setSubPage(null);
    } catch (e: any) {
      toast.error(e);
    } finally {
      setSaving(false);
    }
  };

  const handleSavePresetBg = async (presetKey: string) => {
    setSaving(true);
    try {
      await updateRoom({ roomId, bgPresetKey: presetKey });
      toast.success("تم تغيير الخلفية ✅");
      setSubPage(null);
    } catch (e: any) {
      toast.error(e);
    } finally {
      setSaving(false);
    }
  };

  const handlePurchaseCustomBg = async () => {
    if (!bgFile) return;
    const vipLevel = myProfile?.vipLevel ?? 0;
    if (!myProfile?.isVip || vipLevel < 5) {
      toast.error("هذه الميزة متاحة لـ VIP5 وأعلى فقط 👑");
      return;
    }
    setPurchasingBg(true);
    try {
      const uploadUrl = await generateUploadUrl();
      const result = await fetch(uploadUrl, { method: "POST", headers: { "Content-Type": bgFile.type }, body: bgFile });
      const json = await result.json();
      if (!result.ok) throw new Error("فشل رفع الصورة");
      await purchaseCustomBg({ roomId, bgStorageId: json.storageId });
      toast.success("تم تفعيل الخلفية المخصصة لمدة 30 يوم ✅");
      setBgFile(null); setBgPreview(null); setSubPage(null);
    } catch (e: any) {
      toast.error(e);
    } finally {
      setPurchasingBg(false);
    }
  };

  const handleRemoveBg = async () => {
    setSaving(true);
    try {
      await updateRoom({ roomId, removeBg: true });
      toast.success("تم إزالة الخلفية");
      setSubPage(null);
    } catch (e: any) {
      toast.error(e);
    } finally {
      setSaving(false);
    }
  };

  if (!room) return (
    <div className="min-h-screen bg-white flex items-center justify-center">
      <div className="w-8 h-8 border-2 border-t-transparent rounded-full animate-spin" style={{ borderColor: "#00bfa5", borderTopColor: "transparent" }} />
    </div>
  );

  const themeLabel = ROOM_THEMES.find((t) => t.value === currentTheme)?.label ?? "الافتراضي";
  const bgLabel = currentBgImage ? "صورة مخصصة" : currentPreset ? (PRESET_BACKGROUNDS.find((b) => b.key === currentPreset)?.label ?? "خلفية محددة") : "بدون خلفية";

  // ── THEME SUB-PAGE ──
  if (subPage === "theme") {
    return (
      <div className="flex flex-col min-h-screen bg-white" dir="rtl">
        <div className="flex items-center gap-4 px-4 py-4 border-b border-gray-100">
          <button onClick={() => setSubPage(null)} className="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#333" strokeWidth="2.5"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <h2 className="flex-1 text-center text-[17px] font-bold text-gray-800">اختيار الثيم</h2>
          <button onClick={handleSaveTheme} disabled={saving}
            className="px-4 py-1.5 rounded-full text-sm font-bold text-white disabled:opacity-50"
            style={{ background: "#00bfa5" }}>
            {saving ? "..." : "حفظ"}
          </button>
        </div>
        <div className="p-4 grid grid-cols-2 gap-4">
          {ROOM_THEMES.map((theme) => {
            const isActive = (pendingTheme ?? currentTheme) === theme.value;
            return (
              <button key={theme.value} onClick={() => setPendingTheme(theme.value)}
                className="relative rounded-2xl overflow-hidden transition-all active:scale-95"
                style={{ border: isActive ? "2.5px solid #00bfa5" : "2px solid #eee", boxShadow: isActive ? "0 4px 20px rgba(0,191,165,0.25)" : "none", aspectRatio: "1" }}>
                <div className="absolute inset-0" style={{ background: theme.gradient }} />
                <div className="relative z-10 flex flex-col items-center justify-center h-full gap-2 p-3">
                  <span className="text-4xl">{theme.icon}</span>
                  <span className="text-white font-bold text-sm drop-shadow">{theme.label}</span>
                </div>
                {isActive && (
                  <div className="absolute top-2 left-2 w-6 h-6 rounded-full flex items-center justify-center" style={{ background: "#00bfa5" }}>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="3"><path d="M20 6L9 17l-5-5" /></svg>
                  </div>
                )}
              </button>
            );
          })}
        </div>
        {(pendingTheme ?? currentTheme) === "cp" && (
          <div className="mx-4 rounded-2xl px-4 py-3 text-sm text-pink-600" style={{ background: "rgba(255,77,109,0.08)", border: "1px solid rgba(255,77,109,0.2)" }}>
            💑 ثيم الحب يضيف خلفية قصر ديزني مع ألعاب نارية وقلوب متطايرة ✨
          </div>
        )}
        {(pendingTheme ?? currentTheme) === "cinema" && (
          <div className="mx-4 rounded-2xl px-4 py-3 text-sm text-red-400" style={{ background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)" }}>
            🎬 ثيم يوتيوب يحوّل الغرفة إلى شاشة سينما — يمكنك إدارة الفيديو من إعداد «إدارة فيديو السينما» ✨
          </div>
        )}
      </div>
    );
  }

  // ── BACKGROUND SUB-PAGE ──
  if (subPage === "background") {
    const isVip5Plus = myProfile?.isVip && (myProfile?.vipLevel ?? 0) >= 5;
    return (
      <div className="flex flex-col min-h-screen bg-white" dir="rtl">
        <div className="flex items-center gap-4 px-4 py-4 border-b border-gray-100">
          <button onClick={() => { setSubPage(null); setBgFile(null); setBgPreview(null); }}
            className="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#333" strokeWidth="2.5"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <h2 className="flex-1 text-center text-[17px] font-bold text-gray-800">خلفيات الغرفة</h2>
          <div className="w-9" />
        </div>
        <div className="flex-1 overflow-y-auto pb-8">

          {/* خلفيات تدرج مجانية */}
          <div className="px-4 pt-4">
            <p className="text-xs font-bold text-gray-400 mb-3 uppercase tracking-wide">خلفيات جاهزة • مجانية</p>
            <div className="grid grid-cols-3 gap-3">
              {PRESET_BACKGROUNDS.map((bg) => {
                const isActive = currentPreset === bg.key && !currentBgImage;
                return (
                  <button key={bg.key} onClick={() => handleSavePresetBg(bg.key)} disabled={saving}
                    className="relative rounded-2xl overflow-hidden transition-all active:scale-95 disabled:opacity-60"
                    style={{ aspectRatio: "1", border: isActive ? "2.5px solid #00bfa5" : "2px solid #eee", boxShadow: isActive ? "0 4px 16px rgba(0,191,165,0.3)" : "none" }}>
                    <div className="absolute inset-0" style={{ background: bg.preview }} />
                    <div className="absolute inset-0 flex items-center justify-center">
                      <span className="text-3xl">{bg.emoji}</span>
                    </div>
                    <div className="absolute bottom-0 left-0 right-0 px-1.5 py-1.5" style={{ background: "rgba(0,0,0,0.55)" }}>
                      <p className="text-white text-[10px] font-bold text-center leading-tight">{bg.label}</p>
                    </div>
                    {isActive && (
                      <div className="absolute top-1.5 left-1.5 w-5 h-5 rounded-full flex items-center justify-center" style={{ background: "#00bfa5" }}>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="3"><path d="M20 6L9 17l-5-5" /></svg>
                      </div>
                    )}
                  </button>
                );
              })}
            </div>
          </div>

          {/* خلفيات صور مجانية */}
          <div className="px-4 pt-5">
            <p className="text-xs font-bold text-gray-400 mb-3 uppercase tracking-wide">خلفيات صور • مجانية 🎁</p>
            <div className="grid grid-cols-3 gap-3">
              {FREE_IMAGE_BACKGROUNDS.map((bg) => {
                const isActive = currentPreset === bg.url;
                return (
                  <button key={bg.key} disabled={saving}
                    onClick={() => handleSavePresetBg(bg.url)}
                    className="relative rounded-2xl overflow-hidden transition-all active:scale-95 disabled:opacity-60"
                    style={{ aspectRatio: "1", border: isActive ? "2.5px solid #00bfa5" : "2px solid #eee", boxShadow: isActive ? "0 4px 16px rgba(0,191,165,0.3)" : "none" }}>
                    <img src={bg.url} alt={bg.label} className="absolute inset-0 w-full h-full object-cover" />
                    <div className="absolute bottom-0 left-0 right-0 px-1.5 py-1.5" style={{ background: "rgba(0,0,0,0.55)" }}>
                      <p className="text-white text-[10px] font-bold text-center leading-tight">{bg.label}</p>
                    </div>
                    {isActive && (
                      <div className="absolute top-1.5 left-1.5 w-5 h-5 rounded-full flex items-center justify-center" style={{ background: "#00bfa5" }}>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="3"><path d="M20 6L9 17l-5-5" /></svg>
                      </div>
                    )}
                  </button>
                );
              })}
            </div>
          </div>

          {/* رفع صورة خاصة — VIP5+ */}
          <div className="flex items-center gap-3 px-4 my-5">
            <div className="flex-1 h-px bg-gray-100" />
            <span className="text-xs text-gray-400 font-bold">أو ارفع صورة خاصة</span>
            <div className="flex-1 h-px bg-gray-100" />
          </div>
          <div className="px-4">
            {!isVip5Plus && (
              <div className="mb-3 rounded-2xl px-4 py-3 flex items-center gap-3"
                style={{ background: "rgba(251,191,36,0.08)", border: "1px solid rgba(251,191,36,0.3)" }}>
                <span className="text-2xl">👑</span>
                <div className="flex-1">
                  <p className="text-sm font-bold text-amber-700">متاح لـ VIP5 وأعلى فقط</p>
                  <p className="text-xs text-amber-500">ترقّ إلى VIP5 لرفع خلفية مخصصة</p>
                </div>
              </div>
            )}
            <div
              className={`w-full rounded-2xl overflow-hidden relative transition-transform ${isVip5Plus ? "cursor-pointer active:scale-[0.98]" : "opacity-50 pointer-events-none"}`}
              style={{ height: "180px", border: bgPreview ? "2px solid #00bfa5" : "2px dashed #ddd", background: bgPreview ? undefined : "#fafafa" }}
              onClick={() => isVip5Plus && bgFileInputRef.current?.click()}>
              {bgPreview ? (
                <>
                  <img src={bgPreview} alt="" className="w-full h-full object-cover" />
                  <div className="absolute inset-0 flex items-center justify-center" style={{ background: "rgba(0,0,0,0.35)" }}>
                    <span className="text-white text-sm font-bold bg-black/40 px-3 py-1.5 rounded-xl">📷 تغيير الصورة</span>
                  </div>
                </>
              ) : currentBgImage ? (
                <>
                  <img src={currentBgImage} alt="" className="w-full h-full object-cover" />
                  <div className="absolute inset-0 flex items-center justify-center" style={{ background: "rgba(0,0,0,0.35)" }}>
                    <span className="text-white text-sm font-bold bg-black/40 px-3 py-1.5 rounded-xl">📷 تغيير الصورة</span>
                  </div>
                </>
              ) : (
                <div className="w-full h-full flex flex-col items-center justify-center gap-3">
                  <div className="w-14 h-14 rounded-2xl flex items-center justify-center"
                    style={{ background: "rgba(0,191,165,0.1)", border: "1px solid rgba(0,191,165,0.3)" }}>
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00bfa5" strokeWidth="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" />
                    </svg>
                  </div>
                  <div className="text-center">
                    <p className="font-bold text-sm" style={{ color: "#00bfa5" }}>اختر صورة من جهازك</p>
                    <p className="text-gray-400 text-xs mt-0.5">JPG, PNG • حتى 10 ميجابايت</p>
                  </div>
                </div>
              )}
            </div>
            <input ref={bgFileInputRef} type="file" accept="image/*" className="hidden" onChange={handleBgFileSelect} />
            {bgCustomExpiresAt && (
              <div className="mt-2 rounded-xl px-3 py-2 text-xs text-center" style={{ background: "rgba(0,191,165,0.08)", color: "#00bfa5" }}>
                ✅ الخلفية المخصصة فعّالة حتى {new Date(bgCustomExpiresAt).toLocaleDateString("ar")}
              </div>
            )}
            {bgFile && isVip5Plus && (
              <button onClick={handlePurchaseCustomBg} disabled={purchasingBg}
                className="mt-3 w-full py-3 rounded-2xl text-white font-bold text-sm transition-all active:scale-95 disabled:opacity-50"
                style={{ background: "linear-gradient(135deg,#00bfa5,#00897b)" }}>
                {purchasingBg ? "جارٍ الرفع..." : "✅ تفعيل الخلفية المخصصة"}
              </button>
            )}
            {(currentBgImage || currentPreset) && (
              <button onClick={handleRemoveBg} disabled={saving}
                className="mt-2 w-full py-2.5 rounded-2xl text-sm font-bold transition-all active:scale-95"
                style={{ background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)", color: "#ef4444" }}>
                🗑️ إزالة الخلفية
              </button>
            )}
          </div>
        </div>
      </div>
    );
  }

  // ── YOUTUBE SUB-PAGE ──
  if (subPage === "youtube") {
    return <YoutubeSettingsSubPage roomId={roomId} onBack={() => setSubPage(null)} />;
  }

  // ── LOCK SUB-PAGE ──
  if (subPage === "lock") {
    return <RoomLockSubPage roomId={roomId} room={room} setRoomLock={setRoomLock} onBack={() => setSubPage(null)} />;
  }

  // ── BANS SUB-PAGE ──
  if (subPage === "bans") {
    return (
      <div className="flex flex-col min-h-screen bg-white" dir="rtl">
        <div className="flex items-center gap-4 px-4 py-4 border-b border-gray-100">
          <button onClick={() => setSubPage(null)} className="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#333" strokeWidth="2.5"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <h2 className="flex-1 text-center text-[17px] font-bold text-gray-800">المحظورون ({bans?.length ?? 0})</h2>
          <div className="w-9" />
        </div>
        <div className="flex-1 overflow-y-auto">
          {!bans || bans.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-20 gap-3">
              <span className="text-5xl">🚫</span>
              <p className="text-gray-400 text-sm">لا يوجد محظورون</p>
            </div>
          ) : (
            bans.map((ban) => (
              <div key={ban._id} className="flex items-center gap-3 px-4 py-3 border-b border-gray-50">
                <div className="w-11 h-11 rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold text-lg"
                  style={{ background: "linear-gradient(135deg,#ef4444,#dc2626)" }}>
                  {ban.profile?.name?.[0] ?? "؟"}
                </div>
                <div className="flex-1 min-w-0">
                  <p className="text-gray-800 text-sm font-bold truncate">{ban.profile?.name ?? "مجهول"}</p>
                  <p className="text-gray-400 text-xs font-mono">#{ban.profile?.sakiId}</p>
                </div>
                <button
                  onClick={async () => {
                    try { await unbanMember({ roomId, targetUserId: ban.userId }); toast.success("تم رفع الحظر ✅"); }
                    catch (e: any) { toast.error(e); }
                  }}
                  className="px-3 py-1.5 rounded-full text-xs font-bold text-white"
                  style={{ background: "#00bfa5" }}>
                  رفع الحظر
                </button>
              </div>
            ))
          )}
        </div>
      </div>
    );
  }

  // ── MAIN PAGE ──
  return (
    <div className="flex flex-col h-screen bg-[#f8f9fa]" dir="rtl">
      <div className="bg-white flex items-center gap-4 px-4 py-4 border-b border-gray-100 flex-shrink-0">
        <button onClick={onBack} className="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#333" strokeWidth="2.5"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <h2 className="flex-1 text-center text-[17px] font-bold text-gray-800">إعدادات الغرفة</h2>
        <button onClick={handleSaveMain} disabled={saving}
          className="px-4 py-1.5 rounded-full text-sm font-bold text-white disabled:opacity-50"
          style={{ background: "#00bfa5" }}>
          {saving ? "..." : "حفظ"}
        </button>
      </div>

      <div className="flex-1 overflow-y-auto pb-10">
        <div className="bg-white flex flex-col items-center px-4 py-6 border-b-8 border-[#f8f9fa]">
          <div className="relative mb-4 cursor-pointer" onClick={() => fileInputRef.current?.click()}>
            <div className="w-24 h-24 rounded-2xl overflow-hidden border-2" style={{ borderColor: "#00bfa5" }}>
              {currentCover ? (
                <img src={currentCover} alt="" className="w-full h-full object-cover" />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-3xl" style={{ background: "linear-gradient(135deg,#e0f2f1,#b2dfdb)" }}>🏠</div>
              )}
            </div>
            <div className="absolute -bottom-1.5 -right-1.5 w-8 h-8 rounded-full flex items-center justify-center border-2 border-white" style={{ background: "#00bfa5" }}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
            </div>
          </div>
          <input ref={fileInputRef} type="file" accept="image/*" className="hidden" onChange={handleCoverSelect} />
          <input value={currentName} onChange={(e) => setName(e.target.value)} placeholder="اسم الغرفة"
            className="text-center text-base font-bold text-gray-800 border-b border-gray-200 pb-2 w-4/5 focus:outline-none bg-transparent"
            style={{ borderBottomColor: "#00bfa5" }} />
          {room.roomNumericId && <p className="text-xs text-gray-400 mt-2 font-mono">#{room.roomNumericId}</p>}
        </div>

        <div className="bg-white mt-2 px-4 py-4 border-b border-gray-50">
          <label className="text-xs font-bold text-gray-400 mb-2 block">وصف الغرفة</label>
          <textarea value={currentDescription} onChange={(e) => setDescription(e.target.value)}
            placeholder="أدخل وصف الغرفة (اختياري)" rows={2}
            className="w-full text-sm text-gray-700 placeholder-gray-300 focus:outline-none resize-none bg-transparent" />
        </div>

        <div className="bg-white mt-2 px-4 py-4 border-b border-gray-50">
          <span className="text-sm font-bold text-gray-700 block mb-3">عدد المقاعد</span>
          <div className="flex gap-2">
            {SEAT_OPTIONS.map((n) => (
              <button key={n} onClick={() => setMaxSeats(n)}
                className="flex-1 py-2.5 rounded-xl text-sm font-bold border transition-all"
                style={currentMaxSeats === n
                  ? { borderColor: "#00bfa5", background: "rgba(0,191,165,0.1)", color: "#00897b" }
                  : { borderColor: "#eee", background: "white", color: "#888" }}>
                {n}
              </button>
            ))}
          </div>
        </div>

        <div className="bg-white mt-2">
          <button onClick={() => setSubPage("theme")}
            className="w-full flex items-center px-4 py-4 border-b border-gray-50 active:bg-gray-50 transition-colors">
            <span className="text-sm text-gray-700 flex-1 text-right">ثيم الغرفة</span>
            <span className="text-sm text-gray-400 ml-2">{themeLabel}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="2" className="mr-1 flex-shrink-0" style={{ transform: "rotate(180deg)" }}>
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <button onClick={() => setSubPage("background")}
            className="w-full flex items-center px-4 py-4 border-b border-gray-50 active:bg-gray-50 transition-colors">
            <span className="text-sm text-gray-700 flex-1 text-right">خلفية الغرفة</span>
            <span className="text-sm text-gray-400 ml-2">{bgLabel}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="2" className="mr-1 flex-shrink-0" style={{ transform: "rotate(180deg)" }}>
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <button onClick={() => setSubPage("bans")}
            className="w-full flex items-center px-4 py-4 border-b border-gray-50 active:bg-gray-50 transition-colors">
            <span className="text-sm text-gray-700 flex-1 text-right">قائمة الحظر</span>
            <span className="text-sm text-gray-400 ml-2">{bans?.length ?? 0}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="2" className="mr-1 flex-shrink-0" style={{ transform: "rotate(180deg)" }}>
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <button onClick={() => setSubPage("youtube")}
            className="w-full flex items-center px-4 py-4 border-b border-gray-50 active:bg-gray-50 transition-colors">
            <span className="text-sm text-gray-700 flex-1 text-right">🎬 إدارة فيديو السينما</span>
            <span className="text-sm ml-2" style={{ color: (room as any)?.youtubeVideoId ? "#22c55e" : "#9ca3af" }}>
              {(room as any)?.youtubeVideoId ? "● يعرض" : "لا يوجد"}
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="2" className="mr-1 flex-shrink-0" style={{ transform: "rotate(180deg)" }}>
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <button onClick={() => setSubPage("lock")}
            className="w-full flex items-center px-4 py-4 border-b border-gray-50 active:bg-gray-50 transition-colors">
            <span className="text-sm text-gray-700 flex-1 text-right">🔒 قفل الغرفة بكلمة مرور</span>
            <span className="text-sm ml-2" style={{ color: (room as any)?.isLocked ? "#ef4444" : "#9ca3af" }}>
              {(room as any)?.isLocked ? "مقفلة 🔒" : "مفتوحة 🔓"}
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="2" className="mr-1 flex-shrink-0" style={{ transform: "rotate(180deg)" }}>
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <RoyalSeatsToggle value={currentHideRoyalSeats} onChange={setHideRoyalSeats} />
        </div>
      </div>
    </div>
  );
}
